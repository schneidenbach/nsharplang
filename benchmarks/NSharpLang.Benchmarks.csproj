<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Matched N#-vs-C# benchmark corpus for the patterns optimized in PR #160.

    Most benchmarks in this project are deliberately outside the default `dotnet test` path:
    they produce manual, wall-clock before/after numbers for PRs. The Systems N# benchmark
    family is also run by scripts/benchmark-systems.sh and the full commit gate because the
    systems profile has an explicit throughput/allocation evidence requirement.

    Run it manually (see benchmarks usage in docs/design/performance-compiler-refactor.md).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks must build in Release for meaningful numbers; allow Debug runs for smoke checks. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <RootNamespace>NSharpLang.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/NSharpLang.Compiler/Compiler.csproj" />
    <ProjectReference Include="../src/NSharpLang.Runtime/NSharpLang.Runtime.csproj" />
  </ItemGroup>

</Project>
