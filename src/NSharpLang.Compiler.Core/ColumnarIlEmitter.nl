        liftedCandidates := _liftedCandidates
        try {
            ColumnarClosureBindingPlanner.ComputeLiftedCandidates(_nodes, _source, bodyRoot, ref liftedCandidates)
        } finally {
            _liftedCandidates = liftedCandidates
        }
