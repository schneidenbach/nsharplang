        if (!_protectedDoneCreated) {
            return
        }
        _il.MarkLabel(_protectedDone)
        if (!isVoid) {
            _il.Emit(OpCodes.Ldloc, _protectedResult)
        }
        _il.Emit(OpCodes.Ret)
    }

    private func EmitStatement(idx: int): bool {
