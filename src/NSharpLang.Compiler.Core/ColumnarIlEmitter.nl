        if (_nodes.Kind(bindNode) != 6 || !TryBuildTypeNodeCanonical(typeNode, out canonical) || !TryResolveBodyType(canonical, out targetType) || !ColumnarTypeOfPlanner.IsSupportedType(targetType)) {
            return false
