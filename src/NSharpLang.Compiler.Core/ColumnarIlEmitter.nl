            // recursive body and constructs the delegate over that exact method.
            placement := ColumnarLambdaPlacementPlanner.PlanNonCapturingPlacement(
                _programType,
                _currentStruct,
                _lambdaCounter,
                _isConstructorBody,
                _typeParameters,
                delegateReturnType,
                signatureTypes,
                hasThisCapture
