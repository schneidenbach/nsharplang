        let counterIncrement: int = 0
        let counterNode: int = 0
        let counterName: string? = null
        if (!TryGetSingleRangeBodyStatement(Child(ifStatementNode, 1), out thenStatement) || !TryGetExpressionStatementExpression(thenStatement, out counterIncrement) || !TryMatchUnitCounterIncrement(counterIncrement, out counterNode, out counterName)) {
            return false
