            if (_nodes.Kind(UnwrapParenthesizedNode(Child(node, 1))) == 5) {
                nullComparisonOperand = Child(node, 0)
            } else if (_nodes.Kind(UnwrapParenthesizedNode(Child(node, 0))) == 5) {
