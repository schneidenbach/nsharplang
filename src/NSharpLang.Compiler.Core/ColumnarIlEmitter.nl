    private func TryResolveTypeBindingPattern(patternNode: int, out targetType: Type, out bindName: string): bool {
        targetType = null
        bindName = ""
        if (_nodes.Kind(patternNode) != 61 || _nodes.ChildCount(patternNode) != 2) {
