        if (!IsSideEffectFreeInt32Bound(boundNode, indexName) || !IsSideEffectFreeInt32Operand(loNode) || !IsSideEffectFreeInt32Operand(hiNode)) {
            return false
        }

        shape = new ColumnarRangeCountShape(
            counterNode,
            arrayNode,
            indexNode,
            boundNode,
            loNode,
            hiNode,
            counterName,
            indexName
        )
        return true
    }

    private func EmitVectorizedRangeCount(shape: ColumnarRangeCountShape): bool {
        boundLocal := _il.DeclareLocal(typeof(int))
