            _il.Emit(OpCodes.Newobj, typeof(InvalidOperationException).GetConstructor([typeof(string)]))
            _il.Emit(OpCodes.Throw)
            _il.MarkLabel(assertOk)
            PushNarrowedNames(assertNarrowing.Then)
