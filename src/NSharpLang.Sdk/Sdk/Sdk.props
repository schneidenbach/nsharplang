<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Auto-detect project.yml in project directory -->
    <NSharpProjectFile Condition="'$(NSharpProjectFile)' == '' And Exists('$(MSBuildProjectDirectory)/project.yml')">$(MSBuildProjectDirectory)/project.yml</NSharpProjectFile>

    <!-- Enable by default -->
    <EnableNSharpCompilation Condition="'$(EnableNSharpCompilation)' == ''">true</EnableNSharpCompilation>
    <EnableNSharpRuntimePackageReference Condition="'$(EnableNSharpRuntimePackageReference)' == ''">true</EnableNSharpRuntimePackageReference>
    <NSharpLangRuntimeVersion Condition="'$(NSharpLangRuntimeVersion)' == ''">0.1.0</NSharpLangRuntimeVersion>
  </PropertyGroup>

  <!-- Import build configuration generated by 'nlc restore' from project.yml.
       This file is the single canonical projection from YAML to MSBuild XML,
       generated by the real YAML parser (YamlDotNet), not regex. -->
  <Import Project="$(MSBuildProjectDirectory)/obj/project.g.props"
          Condition="Exists('$(MSBuildProjectDirectory)/obj/project.g.props')" />

  <!-- OutputType cannot wait for a target. The base SDK derives _IsExecutable, HasRuntimeOutput and
       IsRidAgnostic from it during EVALUATION, and a referencing project reads those three back as this
       project's outer facts, so an `outputType: library` project whose OutputType still held the Exe
       placeholder announced itself as a non self-contained executable: a self-contained consumer then
       failed NETSDK1150 in ValidateExecutableReferences, before a single N# file was compiled. Only
       `nlc restore` writes obj/project.g.props, so on any clean checkout the placeholder is what the
       consumer saw. Read that one field out of project.yml here, at evaluation time, in pure MSBuild.
       The YamlDotNet projection above still wins whenever it exists, and the LoadProjectConfig task in
       Sdk.targets re-asserts every field - including this one - from the real parser. Only the two values
       ProjectFileParser accepts are recognized; anything else keeps the placeholder so the parser can
       report the malformed value with its own diagnostic. -->
  <PropertyGroup Condition="'$(OutputType)' == '' And Exists('$(NSharpProjectFile)')">
    <_NSharpDeclaredOutputType>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(NSharpProjectFile))), '(?m)^outputType[ \t]*:[ \t]*[&quot;%27]?(exe|library)[&quot;%27]?(?:[ \t]+#[^\r\n]*)?[ \t]*\r?$').Groups.get_Item(1).Value)</_NSharpDeclaredOutputType>
    <OutputType Condition="'$(_NSharpDeclaredOutputType)' == 'library'">Library</OutputType>
    <OutputType Condition="'$(_NSharpDeclaredOutputType)' == 'exe'">Exe</OutputType>
  </PropertyGroup>

  <!-- Minimum defaults so MSBuild evaluation doesn't crash when project.g.props
       is missing. The validation target in Sdk.targets will emit a clear error
       at build time if project.yml exists but project.g.props does not. -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <_NSharpBaseSdk Condition="'$(_NSharpBaseSdk)' == ''">Microsoft.NET.Sdk</_NSharpBaseSdk>
  </PropertyGroup>

  <!-- N# exe projects provide their own entry points through emitted N# code,
       so disable auto-generated Program.cs to avoid duplicate Main conflicts.
       Library projects with tests need the test SDK to generate the entry point,
       so GenerateProgramFile stays enabled (default) for Library.
       This must be set at evaluation time, before Microsoft.NET.Test.Sdk's
       InitialTargets runs the GenerateProgramFile target. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- Import base SDK props (dynamic based on project.yml sdk field) -->
  <Import Project="Sdk.props" Sdk="$(_NSharpBaseSdk)" />

  <!-- Runtime-backed language features must restore without users editing the
       intentionally minimal .csproj. Compiler Core declares its own runtime
       package through project.yml so the native CLI and MSBuild agree on the edge. -->
  <ItemGroup Condition="'$(EnableNSharpCompilation)' == 'true' And '$(EnableNSharpRuntimePackageReference)' == 'true' And '$(MSBuildProjectName)' != 'NSharpLang.Compiler.Core'">
    <PackageReference Include="NSharpLang.Runtime" Version="$(NSharpLangRuntimeVersion)" />
  </ItemGroup>

</Project>
