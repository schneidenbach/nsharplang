<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Import base SDK targets (dynamic based on project.yml sdk field, set in Sdk.props) -->
  <Import Project="Sdk.targets" Sdk="$(_NSharpBaseSdk)" />

  <!-- No apphost in Debug: rebuilding while the app runs trips NETSDK1177, and `dotnet run` does not need one.
       Release still produces a native executable. After the base SDK import so $(Configuration) is resolved. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost Condition="'$(UseAppHost)' == ''">false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The compiler compiles ITSELF emit-only: Compiler Core and every slice carved out of it. Their
         analysis is the self-host front door's job (test-all-core.sh Step 2d), not the seed's. -->
    <NSharpEmitValidateWithLegacyAnalysis Condition="'$(NSharpEmitValidateWithLegacyAnalysis)' == '' And ('$(MSBuildProjectName)' == 'NSharpLang.Compiler.Core' Or '$(MSBuildProjectName)' == 'NSharpLang.Compiler.Syntax' Or '$(MSBuildProjectName)' == 'NSharpLang.Compiler.Model')">false</NSharpEmitValidateWithLegacyAnalysis>
    <NSharpEmitValidateWithLegacyAnalysis Condition="'$(NSharpEmitValidateWithLegacyAnalysis)' == ''">true</NSharpEmitValidateWithLegacyAnalysis>
    <_NSharpEmitStamp>$(IntermediateOutputPath)nsharp.emit.stamp</_NSharpEmitStamp>
  </PropertyGroup>

  <UsingTask TaskName="NSharpLang.Build.Tasks.LoadProjectReferences"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Core.dll" />
  <UsingTask TaskName="NSharpLang.Build.Tasks.LoadProjectConfig"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Core.dll" />
  <UsingTask TaskName="NSharpLang.Build.Tasks.EmitIlAssembly"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Core.dll" />

  <!-- Apply project.yml in THIS invocation as well as through obj/project.g.props, so direct dotnet builds and
       ProjectReference consumers work even before nlc restore has generated the compatibility props file. -->
  <Target Name="_ApplyNSharpProjectConfigForCurrentBuild"
          BeforeTargets="_GetRestoreProjectStyle;_GetRestoreTargetFrameworksOutput;_GenerateRestoreProjectSpec;_GenerateRestoreProjectPathItemsPerFramework;GetTargetPath;GetTargetPathWithTargetPlatformMoniker;PrepareForBuild;CollectPackageReferences;ResolvePackageAssets;ResolveFrameworkReferences;AssignProjectConfiguration;CoreCompile"
          Condition="Exists('$(NSharpProjectFile)')">
    <LoadProjectConfig ProjectDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="TargetFramework" PropertyName="TargetFramework" />
      <Output TaskParameter="OutputType" PropertyName="OutputType" />
      <Output TaskParameter="AssemblyName" PropertyName="AssemblyName" />
      <Output TaskParameter="Version" PropertyName="_NSharpProjectVersion" />
      <Output TaskParameter="AssemblyVersion" PropertyName="_NSharpProjectAssemblyVersion" />
      <Output TaskParameter="FileVersion" PropertyName="_NSharpProjectFileVersion" />
      <Output TaskParameter="Sdk" PropertyName="_NSharpBaseSdk" />
      <Output TaskParameter="TestFramework" PropertyName="NSharpTestFramework" />
      <Output TaskParameter="PackageId" PropertyName="_NSharpPackageId" />
      <Output TaskParameter="PackageAuthors" PropertyName="_NSharpPackageAuthors" />
      <Output TaskParameter="PackageDescription" PropertyName="_NSharpPackageDescription" />
      <Output TaskParameter="PackageTags" PropertyName="_NSharpPackageTags" />
      <Output TaskParameter="PackageLicenseExpression" PropertyName="_NSharpPackageLicenseExpression" />
      <Output TaskParameter="PackageProjectUrl" PropertyName="_NSharpPackageProjectUrl" />
      <Output TaskParameter="RepositoryUrl" PropertyName="_NSharpRepositoryUrl" />
      <Output TaskParameter="PackageReadmeFile" PropertyName="_NSharpPackageReadmeFile" />
      <Output TaskParameter="PackageReadmeSource" PropertyName="_NSharpPackageReadmeSource" />
    </LoadProjectConfig>

    <LoadProjectReferences ProjectFile="$(NSharpProjectFile)" ExistingProjectReferences="@(ProjectReference->'%(FullPath)')">
      <Output TaskParameter="PackageReferences" ItemName="PackageReference" />
      <Output TaskParameter="FrameworkReferences" ItemName="FrameworkReference" />
      <Output TaskParameter="ProjectReferences" ItemName="ProjectReference" />
    </LoadProjectReferences>

    <PropertyGroup Condition="'$(AssemblyName)' != ''">
      <TargetName>$(AssemblyName)</TargetName>
      <TargetFileName>$(TargetName)$(TargetExt)</TargetFileName>
      <TargetPath>$(TargetDir)$(TargetFileName)</TargetPath>
      <TargetRefPath Condition="'$(ProduceReferenceAssembly)' == 'true' And '$(ProduceReferenceAssemblyInOutDir)' == 'true'">$([MSBuild]::NormalizePath($(TargetDir), 'ref', $(TargetFileName)))</TargetRefPath>
      <TargetRefPath Condition="'$(ProduceReferenceAssembly)' == 'true' And '$(ProduceReferenceAssemblyInOutDir)' != 'true'">$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'ref', $(TargetFileName)))</TargetRefPath>
      <ProjectDepsFileName>$(AssemblyName).deps.json</ProjectDepsFileName>
      <ProjectDepsFilePath>$(TargetDir)$(ProjectDepsFileName)</ProjectDepsFilePath>
      <ProjectRuntimeConfigFileName>$(AssemblyName).runtimeconfig.json</ProjectRuntimeConfigFileName>
      <ProjectRuntimeConfigFilePath>$(TargetDir)$(ProjectRuntimeConfigFileName)</ProjectRuntimeConfigFilePath>
      <ProjectRuntimeConfigDevFilePath Condition="'$(GenerateRuntimeConfigDevFile)' == 'true'">$(TargetDir)$(AssemblyName).runtimeconfig.dev.json</ProjectRuntimeConfigDevFilePath>
      <PackageId Condition="'$(_NSharpPackageId)' != ''">$(_NSharpPackageId)</PackageId>
      <Authors Condition="'$(_NSharpPackageAuthors)' != ''">$(_NSharpPackageAuthors)</Authors>
      <Description Condition="'$(_NSharpPackageDescription)' != ''">$(_NSharpPackageDescription)</Description>
      <PackageDescription Condition="'$(_NSharpPackageDescription)' != ''">$(_NSharpPackageDescription)</PackageDescription>
      <PackageTags Condition="'$(_NSharpPackageTags)' != ''">$(_NSharpPackageTags)</PackageTags>
      <PackageLicenseExpression Condition="'$(_NSharpPackageLicenseExpression)' != ''">$(_NSharpPackageLicenseExpression)</PackageLicenseExpression>
      <PackageProjectUrl Condition="'$(_NSharpPackageProjectUrl)' != ''">$(_NSharpPackageProjectUrl)</PackageProjectUrl>
      <RepositoryUrl Condition="'$(_NSharpRepositoryUrl)' != ''">$(_NSharpRepositoryUrl)</RepositoryUrl>
      <PackageReadmeFile Condition="'$(_NSharpPackageReadmeFile)' != ''">$(_NSharpPackageReadmeFile)</PackageReadmeFile>
      <PackageId Condition="'$(PackageId)' == '' Or '$(PackageId)' == '$(MSBuildProjectName)'">$(AssemblyName)</PackageId>
    </PropertyGroup>

    <ItemGroup Condition="'$(_NSharpPackageReadmeSource)' != ''">
      <None Include="$(_NSharpPackageReadmeSource)" Pack="true" PackagePath="$(PackageReadmeFile)" Visible="false" />
    </ItemGroup>

    <PropertyGroup Condition="'$(_NSharpProjectVersion)' != ''">
      <Version Condition="'$(Version)' == '' Or '$(Version)' == '1.0.0'">$(_NSharpProjectVersion)</Version>
      <PackageVersion Condition="'$(PackageVersion)' == '' Or '$(PackageVersion)' == '1.0.0'">$(_NSharpProjectVersion)</PackageVersion>
      <AssemblyVersion Condition="'$(_NSharpProjectAssemblyVersion)' != '' And ('$(AssemblyVersion)' == '' Or '$(AssemblyVersion)' == '1.0.0.0')">$(_NSharpProjectAssemblyVersion)</AssemblyVersion>
      <FileVersion Condition="'$(_NSharpProjectFileVersion)' != '' And ('$(FileVersion)' == '' Or '$(FileVersion)' == '1.0.0.0')">$(_NSharpProjectFileVersion)</FileVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(AssemblyName)' != ''">
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(IntermediateOutputPath)$(TargetName)$(TargetExt)" />
      <IntermediateRefAssembly Remove="@(IntermediateRefAssembly)" />
      <IntermediateRefAssembly Include="$(IntermediateOutputPath)refint\$(TargetName)$(TargetExt)" Condition="'@(IntermediateRefAssembly)' == ''" />
    </ItemGroup>

    <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
      <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(EnableNSharpCompilation)' == 'true'">
    <NSharpCompile Include="**/*.nl" Exclude="**/*.tests.nl;**/obj/**;**/bin/**" />
  </ItemGroup>

  <!-- A reference of the tested project compiles product-only (Sdk.props, `_NSharpTestedProject`). -->
  <ItemGroup Condition="'$(EnableNSharpCompilation)' == 'true' And '$(NSharpExcludeTests)' != 'true' And '$(_NSharpReferencedByTestedProject)' != 'true'">
    <NSharpTestFiles Include="**/*.tests.nl" Exclude="**/obj/**;**/bin/**" />
  </ItemGroup>

  <!-- THE TESTED PROJECT'S NAME TRAVELS WITH ITS REFERENCES, in both phases that walk them (Sdk.props
       says why). An item definition reaches every `ProjectReference` that does not spell its own
       `AdditionalProperties`, including the ones `LoadProjectReferences` synthesizes from project.yml
       inside a target, which carry no metadata at all. NuGet's restore walk passes no per-reference
       metadata at all - only this one property list, to every project it evaluates - so the name rides
       there too; the tested project reads its own name back and stays tests-included. -->
  <ItemDefinitionGroup Condition="'$(EnableNSharpCompilation)' == 'true' And '$(_NSharpTestedProject)' != ''">
    <ProjectReference>
      <AdditionalProperties>%(AdditionalProperties);_NSharpTestedProject=$(_NSharpTestedProject)</AdditionalProperties>
    </ProjectReference>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(EnableNSharpCompilation)' == 'true' And '$(_NSharpTestedProject)' != ''">
    <_GenerateRestoreGraphProjectEntryInputProperties>$(_GenerateRestoreGraphProjectEntryInputProperties);_NSharpTestedProject=$(_NSharpTestedProject)</_GenerateRestoreGraphProjectEntryInputProperties>
  </PropertyGroup>

  <!-- Add test framework dependencies when test files exist (done in a target so NuGet restore sees them) -->
  <Target Name="AddNSharpTestDependencies" BeforeTargets="CollectPackageReferences" Condition="'$(EnableNSharpCompilation)' == 'true'">
    <PropertyGroup>
      <_NSharpTestFiles>@(NSharpTestFiles)</_NSharpTestFiles>
      <NSharpTestFramework Condition="'$(NSharpTestFramework)' == ''">xunit</NSharpTestFramework>
    </PropertyGroup>

    <ItemGroup Condition="'$(_NSharpTestFiles)' != '' And '$(NSharpTestFramework)' == 'xunit'">
      <PackageReference Include="xunit" Version="2.9.2" />
      <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
      <PackageReference Include="coverlet.msbuild" Version="6.0.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(_NSharpTestFiles)' != '' And '$(NSharpTestFramework)' == 'nunit'">
      <PackageReference Include="NUnit" Version="4.3.2" />
      <PackageReference Include="NUnit3TestAdapter" Version="4.6.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
      <PackageReference Include="coverlet.msbuild" Version="6.0.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <PropertyGroup Condition="'$(_NSharpTestFiles)' != ''">
      <HasNSharpTestFiles>true</HasNSharpTestFiles>

      <CoverletOutputFormat Condition="'$(CoverletOutputFormat)' == ''">opencover</CoverletOutputFormat>
      <CoverletOutput Condition="'$(CoverletOutput)' == ''">$(MSBuildProjectDirectory)/coverage.</CoverletOutput>
      <!-- Only enable by default if explicitly requested -->
      <CollectCoverage Condition="'$(CollectCoverage)' == ''">false</CollectCoverage>
    </PropertyGroup>
  </Target>

  <Target Name="CoreCompile"
          Condition="'$(EnableNSharpCompilation)' == 'true' And ('@(NSharpCompile)' != '' Or '@(NSharpTestFiles)' != '')">
    <Message Importance="High" Text="Skipping CoreCompile for N# project; emitting direct IL assembly." />
  </Target>

  <!-- The emit is skipped only when the sources, project.yml, the resolved references, the SDK's own tool assemblies AND the source-set identity are all unchanged. The stamp's CONTENT is that identity (which files, tests in or out, configuration), so a tests-included build can never be satisfied by the product-only assembly sitting at the same obj path, and the product build after it cannot inherit the tests-included one. -->
  <Target Name="_NSharpEmitStampIdentity" BeforeTargets="EmitNSharpIlAssembly" Condition="'$(EnableNSharpCompilation)' == 'true'">
    <PropertyGroup>
      <_NSharpEmitKey>@(NSharpCompile);@(NSharpTestFiles);$(NSharpProjectFile);$(Configuration);$(DefineConstants);$(NSharpEmitValidateWithLegacyAnalysis)</_NSharpEmitKey>
      <_NSharpEmitId>$([MSBuild]::StableStringHash($(_NSharpEmitKey), 'Sha256'))</_NSharpEmitId>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_NSharpEmitStamp)" Condition="Exists('$(_NSharpEmitStamp)')">
      <Output TaskParameter="Lines" ItemName="_NSharpEmitPrevId" />
    </ReadLinesFromFile>
    <Delete Files="$(_NSharpEmitStamp)" Condition="Exists('$(_NSharpEmitStamp)') And '@(_NSharpEmitPrevId)' != '$(_NSharpEmitId)'" />
  </Target>
  <!-- THE UP-TO-DATE CHECK READS THE REFERENCE ASSEMBLIES; THE COMPILER STILL READS THE IMPLEMENTATIONS.
       `@(ReferencePath)`'s identity for a project reference is that project's `$(TargetPath)`: the
       implementation in `bin/`, which `CopyFilesToOutputDirectory` rewrites on every emit, so a dependent
       project was out of date whenever a project it references was BUILT, whatever changed in it.
       `@(ReferencePathWithRefAssemblies)` substitutes `%(ReferencePath.ReferenceAssembly)` where one exists,
       and `CopyRefAssembly` leaves that file's timestamp alone when the module version ids match, which they
       now do for an implementation-only edit. `FindReferenceAssembliesForReferences` is what populates the
       item, and MSBuild evaluates `Inputs` after `DependsOnTargets` has run.
       `References=` deliberately stays `@(ReferencePath)`: the columnar back end binds against runtime
       `Type` objects and the CLR refuses to load an assembly carrying `[ReferenceAssembly]` for execution. -->
  <Target Name="EmitNSharpIlAssembly"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="FindReferenceAssembliesForReferences"
          Inputs="@(NSharpCompile);@(NSharpTestFiles);$(NSharpProjectFile);@(ReferencePathWithRefAssemblies);$(MSBuildThisFileDirectory)../tools/NSharpLang.Build.Tasks.dll;$(MSBuildThisFileDirectory)../tools/Compiler.dll;$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Model.dll;$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Syntax.dll;$(MSBuildThisFileDirectory)../tools/NSharpLang.Compiler.Core.dll"
          Outputs="$(_NSharpEmitStamp);@(IntermediateAssembly)"
          Condition="'$(EnableNSharpCompilation)' == 'true' And ('@(NSharpCompile)' != '' Or '@(NSharpTestFiles)' != '')">
    <ItemGroup>
      <_NSharpIlSources Include="@(NSharpCompile)" />
      <_NSharpIlSources Include="@(NSharpTestFiles)" />
    </ItemGroup>

    <Message Importance="High" Text="Emitting N# IL assembly to @(IntermediateAssembly)..." />

    <EmitIlAssembly
      Sources="@(_NSharpIlSources)"
      References="@(ReferencePath)"
      ProjectRoot="$(MSBuildProjectDirectory)"
      ProjectFile="$(NSharpProjectFile)"
      AssemblyVersion="$(AssemblyVersion)"
      Configuration="$(Configuration)"
      DefineConstants="$(DefineConstants)"
      TargetAssemblyPath="@(IntermediateAssembly)"
      TargetReferenceAssemblyPath="@(IntermediateRefAssembly)"
      ValidateWithLegacyAnalysis="$(NSharpEmitValidateWithLegacyAnalysis)" />
    <WriteLinesToFile File="$(_NSharpEmitStamp)" Lines="$(_NSharpEmitId)" Overwrite="true" />
  </Target>

  <Target Name="FormatNSharp" Condition="'$(EnableNSharpCompilation)' == 'true'">
    <PropertyGroup>
      <NSharpCliPath Condition="'$(NSharpCliPath)' == ''">nlc</NSharpCliPath>
      <FormatVerifyFlag Condition="'$(FormatVerify)' == 'true'">--verify-no-changes</FormatVerifyFlag>
    </PropertyGroup>

    <Message Importance="High" Text="Formatting N# files..." />

    <Exec Command="$(NSharpCliPath) format $(FormatVerifyFlag)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false" />
  </Target>

  <Target Name="GenerateCoverageReport"
          Condition="'$(HasNSharpTestFiles)' == 'true' And '$(GenerateCoverageReport)' == 'true'">
    <PropertyGroup>
      <CoverageReportDir Condition="'$(CoverageReportDir)' == ''">$(MSBuildProjectDirectory)/coverage-report</CoverageReportDir>
      <CoverageFiles Condition="'$(CoverageFiles)' == ''">$(MSBuildProjectDirectory)/coverage.*.xml</CoverageFiles>
    </PropertyGroup>

    <Message Importance="High" Text="Generating HTML coverage report..." />

    <Exec Command="reportgenerator -reports:&quot;$(CoverageFiles)&quot; -targetdir:&quot;$(CoverageReportDir)&quot; -reporttypes:Html"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true" />

    <Message Importance="High" Text="Coverage report generated at: $(CoverageReportDir)/index.html" />
  </Target>

</Project>
